**/local.settings.*.json
!**/local.settings.example.json

# Frontend dependencies, builds, coverage, and tool caches
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
**/.vite/
**/*.tsbuildinfo

# Go build output and caches
**/.gocache/
**/bin/
*.exe
*.test
coverage.out

# Azure Functions packaging and local emulators
azure-functions/*.zip
**/.azurite/

# Terraform local state, plans, variables, and overrides
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

